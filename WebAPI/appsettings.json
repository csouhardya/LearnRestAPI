{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Key": "<64_ChARS_SUPER_SECRET_KEY_AS_USED_SHA512_WHICH_REQUIRES_512/64_BIT/BYTES>",
    "Issuer": "<VALID_ISSUER_BY_WHOM_TOKEN_IS_CREATED>",
    "Audience": "<VALID_AUDIENCE_FOR_WHOM_TOKEN_IS_CREATED>"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "AllowAutoCreateTopics": true,
    "Acks": -1,
    "MessageSendMaxRetries": 5,
    "RetryBackoffMs": 90,
    "EnableIdempotence": true
  },
  "Email": {
    "Address": "<BUSINESS_GMAIL_ADDRESS>",
    "Password": "<APP_PASSWORD_FOR_GMAIL_NOT_REAL_PASSWORD>"
  },
  "AllowedHosts": "*"
}
